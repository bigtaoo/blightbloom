# Dependencies
node_modules/

# Build output
dist/
# Game-portal bundle (generated from src/main.crazygames.ts by build:crazygames, design/20).
# Its own directory so it cannot overwrite the Cloudflare build, hence its own rule.
client/dist-crazygames/
*.tsbuildinfo
# WeChat mini-game bundle (generated from src/main.wechat.ts by build:wechat)
client/wechat/js/
# Capacitor native projects (generated on demand via `cap add`)
client/android/
client/ios/
# Local WeChat DevTools project: build:wechat generates game.js/game.json/js here,
# and project.config.json carries an account-specific appid. Not source — recreate
# via a DevTools "new mini-game project" + `npm run build:wechat`. See design/04-wechat.md.
platforms/

# Recorded runs (engine/replayFile.ts). A repro file is dropped into client/public/ so
# `?replay=/ddreplay-….json` can fetch it — it is evidence for one bug, never source, and
# it would otherwise be bundled into every build.
client/public/ddreplay-*.json

# Logs
*.log
npm-debug.log*

# Local SQLite account DB (design/16-accounts.md) — dev/runtime state, not source
server/data/

# Real credentials. `server/.env.example` (names, empty values) is the committed template;
# anything holding an ACTUAL secret is not source and must never be committed — Paddle's
# API key and webhook secret land here first (design/19-server-platform.md §9, ROADMAP 9.4).
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python (tools/audio-pipeline is the only Python in the repo — see its README)
__pycache__/
*.py[cod]
venv/

# The audio drivers' scratch working directories. Each one reads a tree of upstream pack
# files (`src/`, `all/`) and writes a batch of candidate mp3s (`out*/`) plus its own report,
# none of which is source: the pack zips are re-fetchable by the sha256 in art/audio/packs.json,
# and only the files that actually ship are archived under art/audio/sources/.
tools/audio-pipeline/src/
tools/audio-pipeline/all/
tools/audio-pipeline/out*/
tools/audio-pipeline/synth.json
tools/audio-pipeline/process*.json

# Coverage output (build/coverageLib.mjs's `<pkg>/coverage/`). Written by every
# `npm run test:coverage`; the gate reads coverage-summary.json out of it and CI uploads the
# html half as an artifact. Never source.
coverage/
