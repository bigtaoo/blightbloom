{
  "name": "daydayup-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "DayDayUp client — PixiJS v8 top-down shooter vertical slice",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:pvp-sim": "vitest run --config vitest.pvp-sim.config.ts --reporter=verbose",
    "test:pve-sim": "vitest run --config vitest.pve-sim.config.ts --reporter=verbose",
    "test:weapon-sim": "vitest run --config vitest.weapon-sim.config.ts --reporter=verbose",
    "audit:arena": "vitest run --config vitest.arena-audit.config.ts --reporter=verbose",
    "replay:inspect": "vitest run --config vitest.replay-inspect.config.ts --reporter=verbose",
    "test:drop-sim": "vitest run --config vitest.drop-reachability.config.ts --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "check:filelength": "node ../build/checkFileLength.mjs",
    "gen:trig": "node tools/gen-trig-tables.mjs",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --config vite.crazygames.config.js",
    "dev:crazygames": "vite --config vite.crazygames.config.js",
    "build:wechat": "tsc --noEmit && vite build --config vite.wechat.config.js",
    "build:wechat:debug": "tsc --noEmit && vite build --config vite.wechat.config.js --mode development",
    "preview": "vite preview --port 4173",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "cap:add:ios": "cap add ios",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1"
  }
}
