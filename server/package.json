{
  "name": "daydayup-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "DayDayUp co-op frame-broadcast gameserver (design/06, ROADMAP 3.1)",
  "scripts": {
    "dev": "node --import tsx/esm src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "matchsvc": "node --import tsx/esm src/matchsvc.ts",
    "billsvc": "node --import tsx/esm src/billsvc/main.ts",
    "adminsvc": "node --import tsx/esm src/adminsvc/main.ts",
    "reconcile": "node --import tsx/esm scripts/reconcile.ts",
    "audit:grants": "node --import tsx/esm scripts/grantAudit.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:filelength": "node ../build/checkFileLength.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2"
  }
}
