# Copy to `.env` next to docker-compose.yml and fill in. Not committed (repo root
# .gitignore already excludes `.env`/`.env.*`, keeping this example alive).
#
# Shared across all three processes (design/19-server-platform.md §3): a mismatch between
# what gameserver/matchsvc/billsvc each read is a silent auth failure, not a loud one.

# HMAC secret over match tickets (server/src/config.ts `ticketSecret()`). Unset falls back
# to a well-known DEV secret with a loud warning — fine for local dev, never for a real
# deploy. Generate: openssl rand -hex 32
BB_TICKET_SECRET=

# Service-to-service auth key (server/src/config.ts `internalKeys()`), shared by
# gameserver → matchsvc (rating reports) and matchsvc ↔ billsvc (store proxy, entitlement
# grants). Unset in production = every internal route fails closed (no fallback — this one
# is not safe to leave blank the way the ticket secret is). Generate: openssl rand -hex 32
BB_INTERNAL_KEY=

# ──────────────────────── the cluster (design/16-accounts.md) ────────────────────────
#
# The four stores — `accounts`, `billing`, `analytics`, `ops` — are four logical DATABASES on
# one MongoDB Atlas cluster since 2026-09-15. They were four `node:sqlite` files until then,
# which is why the bind-mount note that used to sit here is gone: no service writes to disk.

# REQUIRED. docker-compose.yml uses `${BB_MONGO_URI:?...}`, so `docker compose up` REFUSES to
# start anything at all while it is unset — deliberately, because the failure mode of a
# default here is a service that comes up healthy against an EMPTY database and starts
# writing accounts into it. matchsvc, billsvc and the backup worker read this one.
BB_MONGO_URI=

# REQUIRED, and a DIFFERENT database user from the one above: the ops console's, with `read`
# on accounts/billing/analytics and `readWrite` on `ops` alone.
#
# This is all that is left of design/21 decision B1 — "the console cannot write player data".
# It used to be `readOnly: true` SQLite handles behind `:ro` bind mounts, enforced by two
# layers neither of which was our code; an Atlas role lives in the cluster's configuration
# where no diff can show it. So adminsvc PROBES it at boot: it attempts a real write to each
# player-data database and refuses to start unless the server refuses. Pointing this at the
# same string as BB_MONGO_URI is therefore a console that will not come up, which is the
# point.
BB_ADMIN_MONGO_URI=

# Optional, and UNSET in production. A prefix on all four database names (`staging_accounts`
# and friends), so one cluster can host a second environment — the free tier allows a handful
# of databases and a second cluster is a second bill. The test suite uses it for isolation.
BB_MONGO_DB_PREFIX=

# Optional, and NEVER set on a real deployment: it turns off the boot-time write probe above,
# for a local mongod, which has no roles at all. A console running with it logs a WARN naming
# the databases it can write and prints `readOnly: false` on every startup line, so a box
# running without B1 never looks like one that holds it.
BB_ADMIN_ALLOW_WRITABLE=

# ─────────────────────────── observability (design/19 §10) ───────────────────────────

# Grafana's admin password, for https://bb.gamestao.com/grafana/. REQUIRED: docker-compose.yml
# uses `${BB_GRAFANA_ADMIN_PASSWORD:?...}`, so `docker compose up` REFUSES to start anything
# at all while it is unset — deliberately, because Grafana's own default is admin/admin and
# this login page is on the public internet. That refusal blocks a whole deploy, so on an
# existing box this line must be added BEFORE the deploy that first ships the Grafana
# service (deploy/README.md §2 has the one-liner). Generate: openssl rand -hex 16
BB_GRAFANA_ADMIN_PASSWORD=

# Optional. `error` | `warn` | `info` (default) | `debug` — the least severe level that
# prints (server/src/log.ts). docker-compose.yml already pins `info` per service; this is
# here for a local run. Note `warn` also silences the 5-minute heartbeat, which is the line
# the "service liveness" dashboard panel counts.
BB_LOG_LEVEL=

# Optional here, set by docker-compose.yml in the deployment: where matchsvc forwards a
# browser's log batch (`POST /client/log`). Unset = client logs are dropped, with one WARN
# at the first push rather than silence. Local equivalent: http://127.0.0.1:3100/loki/api/v1/push
BB_LOKI_PUSH_URL=

# ────────────────────────── analytics (design/21-ops-analytics.md) ──────────────────────────

# Optional here, set by docker-compose.yml in the deployment: whether this deployment
# collects analytics at all (design/21 §2.4). `1` or `true` switches it on; ANYTHING ELSE,
# including an empty value, leaves it off — so `POST /client/events` still answers 200 and
# stores nothing, and `/metrics` carries no analytics gauges at all rather than zeroed ones.
#
# It replaced `BB_ANALYTICS_DB_PATH`, and that is not a rename. The old variable was a FILE
# PATH whose ABSENCE was the switch: there was no default path, so nothing to collect into.
# `store('analytics')` always resolves, so the switch had to be said out loud or the port
# would have turned collection on for every deployment that upgraded — silently, by omission,
# in the one subsystem with a privacy policy attached.
#
# adminsvc reads the SAME variable to decide whether to show a retention tab, so the console
# and the collector cannot disagree about a deployment's state.
BB_ANALYTICS_ENABLED=

# Optional: whether the ops console has a flag store (design/21 §4). Same shape and the same
# reason as the line above — it replaced `BB_OPS_DB_PATH`, whose absence used to be the
# switch. Unset means the flags tab says so, `/internal/flags` answers 503, and every service
# runs on its compiled-in defaults, which is the shipped behaviour.
BB_OPS_FLAGS_ENABLED=
