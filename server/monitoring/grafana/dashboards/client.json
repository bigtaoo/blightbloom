{
  "uid": "bb-client-logs",
  "title": "Client — browser logs",
  "tags": [
    "blightbloom",
    "logs",
    "client"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "build target",
        "type": "custom",
        "query": "web,wechat,crazygames",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "type": "custom",
        "query": "error,warn,info,debug",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "session",
        "label": "session id",
        "type": "textbox",
        "description": "An opaque per-visit id, from the `session=` field on any line. Filters this whole dashboard down to one player's visit.",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "acct",
        "label": "account id",
        "type": "textbox",
        "description": "Resolved SERVER-side from the request's bearer token, so it is present only for a logged-in player and can never be forged by a client.",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "search",
        "label": "contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sessions reporting",
      "description": "Distinct browser sessions that sent at least one line in the window. Zero with a live game is the shape of a BROKEN pipeline — an unset BB_LOKI_PUSH_URL, a CORS failure on the client, a client build with the logger disabled — not of a quiet day.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (session) (count_over_time({source=\"client\", host=~\"$host\"} | logfmt [$__range])))",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Client errors in range",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({source=\"client\", level=\"error\", host=~\"$host\"} [$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Client log volume by build target",
      "description": "Split by target rather than summed, because that is the comparison that answers most questions here: an error rate that is high on `crazygames` and normal on `web` is a portal problem, and the same rate on both is ours.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (host) (count_over_time({source=\"client\", host=~\"$host\", level=~\"$level\"} [$__auto]))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Client errors by build version, in range",
      "description": "`ver` comes from the client's own build manifest. A version that appears here and nowhere in the sessions count is a build somebody is still running after a deploy.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (ver) (count_over_time({source=\"client\", level=\"error\", host=~\"$host\"} | logfmt [$__range]))",
          "legendFormat": "{{ver}}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Client errors by area (tag), in range",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (tag) (count_over_time({source=\"client\", level=\"error\", host=~\"$host\"} | logfmt [$__range]))",
          "legendFormat": "{{tag}}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Client errors and warnings",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"client\", host=~\"$host\", level=~\"error|warn\"} | logfmt | session=~\"$session.*\" | acct=~\"$acct.*\" |~ \"(?i)$search\""
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "One session, in order — set the `session id` variable above",
      "description": "Ascending, unlike every other log panel here: reading a single visit is reading a story, and a crash makes sense only after what led to it.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"client\", host=~\"$host\", level=~\"$level\"} | logfmt | session=~\"$session.*\" | acct=~\"$acct.*\" |~ \"(?i)$search\""
        }
      ]
    }
  ]
}
