// Alloy: Docker socket -> container stdout/stderr -> parsed labels -> Loki.
//
// Ported from `funny`'s server/observability/alloy/config.alloy. Two things about it are
// load-bearing and worth reading before changing anything here.
//
// **It discovers by container NAME, filtered to `bb-*`.** funny's version scrapes every
// container on its host, which is correct there because the host runs nothing else. This
// filter was written when that was emphatically not true here: the box was the company's,
// borrowed for its spare capacity, and ran their wnet stack, their own
// Loki/Promtail/Grafana and `deutsch-sync` alongside us — an unfiltered collector would
// have copied another team's logs into our store. (Their promtail scraped the same socket
// unfiltered in the other direction, and this file could never close that half.)
//
// Since 2026-09-15 the box is ours and runs nothing else, so the filter guards nothing that
// exists today. It stays because what it prevents did not move out with the neighbours: the
// next container somebody runs here for five minutes of debugging would otherwise be
// collected and retained, and the first symptom of that is storage, not an error.
//
// **Labels stay low-cardinality, always.** Only `source`, `svc`, `level` and `container`.
// Everything identifying — an account id, a room id, an order id — stays in the line body
// as `key=value` and is parsed at QUERY time with `| logfmt`. A label per room id would
// make a stream per match, which is the standard way to make Loki unusable.

// ── Discovery: this project's containers only ───────────────────────────────────────────
discovery.docker "bb" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "10s"

	// Docker's own name filter is a substring match, so this catches every container this
	// compose project creates (`bb-gameserver`, `bb-loki`, ...) and nothing else.
	filter {
		name   = "name"
		values = ["bb-"]
	}
}

discovery.relabel "bb" {
	targets = discovery.docker.bb.targets

	// Belt and braces: the filter above is applied by the Docker daemon, this one by
	// Alloy. A daemon that ignores or loosens the filter (it is documented as a substring
	// match, not an anchored one) would otherwise silently start collecting the whole box.
	// Anchored at the start, unlike Docker's substring match, so a stray `my-bb-scratch`
	// is not swept in by the looser filter above.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/bb-.*"
		action        = "keep"
	}

	// `/bb-matchsvc` -> container="bb-matchsvc", svc="matchsvc".
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/bb-(.*)"
		target_label  = "svc"
	}

	// The one label that separates the two halves of this store. `/client/log` pushes with
	// source="client"; everything Alloy collects is source="backend". Every dashboard
	// starts from this selector.
	rule {
		target_label = "source"
		replacement  = "backend"
	}
}

// ── Collection ──────────────────────────────────────────────────────────────────────────
loki.source.docker "bb" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.bb.output
	relabel_rules = discovery.relabel.bb.rules
	forward_to    = [loki.process.parse.receiver]
}

// ── Parse the structured line `src/log.ts` writes ───────────────────────────────────────
loki.process "parse" {
	// `12:34:56.789 INFO  [matchsvc] a message key=value` (server/src/log.ts). A line that
	// does not match — Node's own `ExperimentalWarning`, Grafana's and Loki's startup
	// output, a raw stack trace continuation — passes through with no `level` label rather
	// than being dropped.
	stage.regex {
		expression = "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}\\s+(?P<level>[A-Z]+)\\s+\\[(?P<tag>[^\\]]+)\\]"
	}

	// `| level="error"` reads better than `| level="ERROR"`, and matches the level names
	// the client half sends. Normalising here means one vocabulary across both sources.
	stage.template {
		source   = "level"
		template = "{{ ToLower .Value }}"
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		// `obs-loki`, not `loki`. The prefix was a collision guard while this project sat on
		// the host's shared `docker_default` network, where the box owner's own Loki already
		// held the alias `loki` — two containers behind one DNS name, pushes landing in the
		// wrong store intermittently, nothing failing anywhere. The network is this
		// project's own now and that collision is gone; the name stays as a role marker (see
		// ../../docker-compose.yml's header), and because renaming it would rewrite every
		// datasource, scrape target and dashboard to buy nothing.
		url = "http://obs-loki:3100/loki/api/v1/push"
	}
}
